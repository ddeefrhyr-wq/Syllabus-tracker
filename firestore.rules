rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // User profiles collection
    match /users/{userId} {
      // Any authenticated user can read user documents (needed for the Centralized Admin Dashboard and unique username lookup)
      allow read: if isSignedIn();
      // Users can write their own profile; admins can update/delete
      allow write: if isOwner(userId) || isSignedIn();
    }

    // Unique Username registry (doc id is lowercase username)
    match /usernames/{username} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // User syllabus progress data
    match /userData/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId) || isSignedIn();
    }
  }
}
